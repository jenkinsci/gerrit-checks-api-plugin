<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="Report pipeline stages to Gerrit">
    <f:entry title="Report stages">
      <f:enum field="reportStages" default="INHERIT">${it.displayName}</f:enum>
    </f:entry>
    <f:entry title="Report stages while the build is running">
      <f:enum field="reportStagesWhileBuilding" default="INHERIT">${it.displayName}</f:enum>
    </f:entry>
    <f:entry title="Report stages as">
      <f:enum field="stageForm" default="INHERIT">${it.displayName}</f:enum>
    </f:entry>
    <f:entry title="Stage depth">
      <f:enum field="stageDepth" default="INHERIT">${it.displayName}</f:enum>
    </f:entry>
    <f:entry title="Maximum depth, only used with 'Up to a maximum depth'" field="maxDepth">
      <f:number default="1" min="1"/>
    </f:entry>
    <f:entry title="Skip the stages Jenkins adds to a declarative pipeline">
      <f:enum field="skipDeclarativeStages" default="INHERIT">${it.displayName}</f:enum>
    </f:entry>
  </f:section>
</j:jelly>
